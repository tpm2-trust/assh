[Unit]
Description=aSSH: sshd's host key, held in the TPM
Documentation=file:///usr/share/doc/assh/README.md
# Early, ahead of anything that could ask the CA too: the CA closes (PCR 15
# extended) once the host key is certified, and stays closed until the next
# boot. The CA and the host key's settings are in assh.conf. sshd starts after it and asks it for every signature.
DefaultDependencies=no
After=local-fs.target tpm2.target
Wants=tpm2.target
Before=sysinit.target sshd.service ssh.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
Type=notify
ExecStart=/usr/bin/assh agent --config /etc/assh/assh.conf
# However the agent ended - a failure included - PCR 15 is extended.
ExecStopPost=/usr/bin/assh close --config /etc/assh/assh.conf
# A restart gets no certificate: the CA is closed until the next boot.
Restart=no

[Install]
WantedBy=sysinit.target
